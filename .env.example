# Which host serves which app/ folder. See proxy.ts. Local values shown (pnpm dev always uses port 3001); use your real domains in production.
# These are read when the app builds, so changing them means rebuilding.
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3001

# Publishes Storybook with `pnpm chromatic`.
CHROMATIC_PROJECT_TOKEN=

# The CityCore API (citycore-server). Browser calls go to /api/v1 on this site and are forwarded to the target.
# Leave NEXT_PUBLIC_API_URL empty to run on mock data.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:4000
